API_ID=
API_HASH=
BOT_TOKEN=
MONGO_DB_URI=
# Optional: shared fallback cluster for the Venom database, only used when
# MONGO_DB_URI is not set. No credentials should ever be committed to source.
#TEMP_MONGO_DB_URI=
LOGGER_ID=
OWNER_ID=
STRING_SESSIONS=
PROXY_URL=

# Set to True to make the assistant account leave the voice chat
# automatically after ASSISTANT_LEAVE_TIME seconds without a track playing.
#AUTO_LEAVING_ASSISTANT=False
#ASSISTANT_LEAVE_TIME=5800

# Optional: browser path for yt-dlp PO Token provider (auto-detected if unset).
# Required only if YouTube returns "Sign in to confirm you're not a bot" errors.
# Install a browser (e.g. `python3 -m playwright install chromium`) and set:
# WPC_BROWSER_PATH=/home/ubuntu/.cache/ms-playwright/chromium-XXXX/chrome-linux/chrome
WPC_BROWSER_PATH=
# Systemd users: set to your unit file (e.g. "venom.service") so /update and
# /restart use `systemctl restart <unit>` instead of self re-exec.
#SERVICE_NAME=
